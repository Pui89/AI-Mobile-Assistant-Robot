{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"HOMEGUARD Simulation Finding Report",
  "type":"object",
  "required":["report_id","generated_at","evidence_status","scenario","seed","notice","findings"],
  "properties":{
    "report_id":{"type":"string"},
    "generated_at":{"type":"string","format":"date-time"},
    "evidence_status":{"const":"SIMULATION-ONLY"},
    "scenario":{"type":"string"},
    "seed":{"type":"integer"},
    "notice":{"type":"string"},
    "findings":{"type":"array","items":{"type":"object",
      "required":["finding_id","observation_id","status","severity","summary","observed_value","evidence","limitations","recommended_action","evidence_status"],
      "properties":{
        "finding_id":{"type":"string"},"observation_id":{"type":"string"},
        "status":{"type":"string"},"severity":{"type":"string"},"summary":{"type":"string"},
        "observed_value":{"type":"number"},"baseline_value":{"type":["number","null"]},
        "deviation":{"type":["number","null"]},"uncertainty":{"type":["number","null"]},
        "evidence":{"type":"array","items":{"type":"string"}},
        "limitations":{"type":"array","items":{"type":"string"}},
        "recommended_action":{"type":"string"},"evidence_status":{"const":"SIMULATION-ONLY"}
      }
    }}
  }
}
