{
  "schema_version": 1,
  "standard": "PUI89-TOTAL-RESILIENCE",
  "project": "Homeguard AI Nomad",
  "project_type": "homeguard-mobile-robot-concept",
  "status": "policy-baseline-only; physical protections not verified",
  "protection_domains": {
    "cybersecurity": "authentication, least privilege, secure updates, local privacy, network isolation, tamper alerts",
    "water_environment": "household spills, humidity, dust, cleaning exposure; ingress rating not established",
    "fire_heat_power": "battery BMS, charging safety, thermal monitoring, overcurrent, safe power isolation",
    "communications": "Wi-Fi/network outage, sensor disconnect, stale commands, local safe behavior",
    "ai_data": "false alarms, missed events, uncertain detection, privacy, data retention",
    "mechanical": "obstacle collision, falls, hand/pull limits, pinch points, emergency stop",
    "human_mission": "child/pet safety, authorized operation, privacy zones, safe stop, manual recovery"
  },
  "project_specific_hazards": [
    "children and pets",
    "indoor obstacles and stairs",
    "hand lifting/pulling mechanism",
    "household spills",
    "privacy-sensitive home monitoring"
  ],
  "shield_system": {
    "status": "architecture_baseline; implementation_and_physical_validation_not_verified",
    "warning_states": [
      "NORMAL",
      "ADVISORY",
      "WARNING",
      "CRITICAL",
      "EMERGENCY",
      "UNKNOWN_DEGRADED"
    ],
    "required_event_fields": [
      "event_id",
      "schema_version",
      "project",
      "component",
      "observed_at",
      "source_id",
      "value",
      "unit",
      "quality",
      "evidence_refs",
      "uncertainty",
      "hazard",
      "severity",
      "warning_state",
      "decision",
      "rationale",
      "human_approval_required",
      "software_version"
    ],
    "fail_safe_rules": [
      "missing_stale_invalid_implausible_or_conflicting_inputs_must_not_be_treated_as_safe",
      "AI_outputs_are_proposals_and_must_not_bypass_project_safety_gates",
      "critical_hardware_protection_must_be_independent_of_AI_software_where_required",
      "project_specific_safe_state_must_be_defined_for_sensor_or_communication_loss",
      "human_authority_is_required_for_high_risk_recovery_and_reset",
      "no_physical_actuation_or_deployment_without_separate_authorization_and_validation"
    ],
    "physical_validation": "NOT_VERIFIED",
    "project_specific_warning_focus": [
      "fire_smoke_heat_and_electrical_anomaly",
      "water_leak_and_humidity",
      "falls_stairs_and_obstacle_collision",
      "child_and_pet_proximity",
      "privacy_or_tampering",
      "sensor_or_network_loss"
    ]
  }
}
